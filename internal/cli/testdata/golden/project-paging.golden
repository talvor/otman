$ otman project list --all --limit 1
exit: 2
-- stdout --
-- stderr --
error:
  code: conflicting_flags
  message: "--all conflicts with --limit"
  details:
    flags[2]: "--all","--limit"
  hint: pass either --all or --limit/--offset

$ otman project list --limit 0
exit: 2
-- stdout --
-- stderr --
error:
  code: invalid_arguments
  message: "--limit must be a positive integer"
  details:
    flag: "--limit"
    value: 0
  hint: null

$ otman project list --offset -1 --json
exit: 2
-- stdout --
-- stderr --
{
  "schema_version": 1,
  "error": {
    "code": "invalid_arguments",
    "message": "--offset must be zero or more",
    "details": {
      "flag": "--offset",
      "value": -1
    },
    "hint": null
  }
}

== tree ==
config/
config/otman/
-- config/otman/config.toml --
vault = "$WORK/vault"
home/
vault/
vault/.otman/
-- vault/.otman/.gitignore --
*
-- vault/.otman/lock --
-- vault/.otman/otman.db --
[sqlite database]
vault/Projects/
vault/Projects/AAA/
-- vault/Projects/AAA/AAA.md --
---
name: first
kind: project
---
vault/Projects/BBB/
-- vault/Projects/BBB/BBB.md --
---
name: second
kind: project
---
vault/Projects/CCC/
-- vault/Projects/CCC/CCC.md --
---
name: third
kind: project
---
