$ otman project create OTM --name otman
tty: true
exit: 0
-- stdout --
Created Project OTM (otman) in Projects/OTM
-- stderr --

$ otman project create OTM --name other --json
exit: 4
-- stdout --
-- stderr --
{
  "schema_version": 1,
  "error": {
    "code": "project_exists",
    "message": "Project OTM already exists at Projects/OTM",
    "details": {
      "key": "OTM",
      "path": "Projects/OTM"
    },
    "hint": "choose another key; otman never overwrites a Project"
  }
}

$ otman project create web --name website
exit: 2
-- stdout --
-- stderr --
error:
  code: invalid_project_key
  message: "invalid Project key \"web\""
  details:
    key: web
  hint: "use an uppercase letter followed by up to 15 uppercase letters or digits, such as OTM"

$ otman project create WEB
tty: true
exit: 2
-- stdout --
-- stderr --
error[invalid_arguments]: --name is required and cannot be empty
hint: pass the Project's display name with --name

$ otman project create WEB --name two
lines
exit: 2
-- stdout --
-- stderr --
error:
  code: invalid_arguments
  message: "--name must be a single line"
  details:
    flag: "--name"
  hint: null

$ otman project create WEB --name Web site: v2 --json
exit: 0
-- stdout --
{
  "schema_version": 1,
  "data": {
    "project": {
      "key": "WEB",
      "name": "Web site: v2",
      "path": "Projects/WEB",
      "note": "Projects/WEB/WEB.md"
    },
    "changed": true
  },
  "warnings": []
}
-- stderr --

