$ otman create --title X --label has space --json
exit: 2
-- stdout --
-- stderr --
{
  "schema_version": 1,
  "error": {
    "code": "invalid_label",
    "message": "invalid Label \"has space\" for --label",
    "details": {
      "flag": "--label",
      "label": "has space",
      "max_length": 64,
      "pattern": "[a-z0-9][a-z0-9._:/-]*"
    },
    "hint": "use lowercase letters, digits and . _ : / -, starting with a letter or digit, at most 64 characters"
  }
}

