$ otman list --state done --json
exit: 2
-- stdout --
-- stderr --
{
  "schema_version": 1,
  "error": {
    "code": "invalid_state",
    "message": "unknown state \"done\"",
    "details": {
      "allowed": [
        "open",
        "closed",
        "all"
      ],
      "state": "done"
    },
    "hint": "use --state open, closed or all"
  }
}

$ otman list --state ""
tty: true
exit: 2
-- stdout --
-- stderr --
error[invalid_state]: unknown state ""
hint: use --state open, closed or all

$ otman list --kind bug --json
exit: 2
-- stdout --
-- stderr --
{
  "schema_version": 1,
  "error": {
    "code": "invalid_kind",
    "message": "unknown Kind \"bug\"",
    "details": {
      "allowed": [
        "issue",
        "prd",
        "spec"
      ],
      "kind": "bug"
    },
    "hint": "use --kind issue, prd or spec"
  }
}

$ otman list --kind ""
exit: 2
-- stdout --
-- stderr --
error:
  code: invalid_kind
  message: "unknown Kind \"\""
  details:
    allowed[3]: issue,prd,spec
    kind: ""
  hint: "use --kind issue, prd or spec"

$ otman list --assignee talvor --unassigned --json
exit: 2
-- stdout --
-- stderr --
{
  "schema_version": 1,
  "error": {
    "code": "conflicting_flags",
    "message": "--assignee conflicts with --unassigned",
    "details": {
      "flags": [
        "--assignee",
        "--unassigned"
      ]
    },
    "hint": "pass either --assignee or --unassigned, not both"
  }
}

$ otman list --assignee @me --unassigned
tty: true
exit: 2
-- stdout --
-- stderr --
error[conflicting_flags]: --assignee conflicts with --unassigned
hint: pass either --assignee or --unassigned, not both

$ otman list --assignee @me --json
exit: 2
-- stdout --
-- stderr --
{
  "schema_version": 1,
  "error": {
    "code": "no_actor",
    "message": "--assignee @me needs an actor, and none is configured",
    "details": {
      "flag": "--assignee"
    },
    "hint": "pass --actor NAME, set OTM_ACTOR, or run 'otman config set actor NAME'"
  }
}

$ otman list --assignee   --json
exit: 2
-- stdout --
-- stderr --
{
  "schema_version": 1,
  "error": {
    "code": "invalid_arguments",
    "message": "--assignee needs a single-line UTF-8 name or @me",
    "details": {
      "flag": "--assignee"
    },
    "hint": null
  }
}

$ otman list --search "" --json
exit: 2
-- stdout --
-- stderr --
{
  "schema_version": 1,
  "error": {
    "code": "invalid_arguments",
    "message": "--search cannot be empty",
    "details": {
      "flag": "--search"
    },
    "hint": "pass the text to search for, or omit --search"
  }
}

$ otman list --all-projects --project WEB --json
exit: 2
-- stdout --
-- stderr --
{
  "schema_version": 1,
  "error": {
    "code": "conflicting_flags",
    "message": "--all-projects conflicts with --project",
    "details": {
      "flags": [
        "--all-projects",
        "--project"
      ]
    },
    "hint": "pass either --all-projects or --project, not both"
  }
}

$ otman list --all --limit 5 --json
exit: 2
-- stdout --
-- stderr --
{
  "schema_version": 1,
  "error": {
    "code": "conflicting_flags",
    "message": "--all conflicts with --limit",
    "details": {
      "flags": [
        "--all",
        "--limit"
      ]
    },
    "hint": "pass either --all or --limit/--offset"
  }
}

$ otman list --all --offset 1
tty: true
exit: 2
-- stdout --
-- stderr --
error[conflicting_flags]: --all conflicts with --offset
hint: pass either --all or --limit/--offset

$ otman list --limit 0 --json
exit: 2
-- stdout --
-- stderr --
{
  "schema_version": 1,
  "error": {
    "code": "invalid_arguments",
    "message": "--limit must be a positive integer",
    "details": {
      "flag": "--limit",
      "value": 0
    },
    "hint": null
  }
}

$ otman list --limit -3
exit: 2
-- stdout --
-- stderr --
error:
  code: invalid_arguments
  message: "--limit must be a positive integer"
  details:
    flag: "--limit"
    value: -3
  hint: null

$ otman list --offset -1 --json
exit: 2
-- stdout --
-- stderr --
{
  "schema_version": 1,
  "error": {
    "code": "invalid_arguments",
    "message": "--offset must be zero or more",
    "details": {
      "flag": "--offset",
      "value": -1
    },
    "hint": null
  }
}

$ otman list --limit many --json
exit: 2
-- stdout --
-- stderr --
{
  "schema_version": 1,
  "error": {
    "code": "invalid_arguments",
    "message": "invalid argument \"many\" for \"--limit\" flag: strconv.ParseInt: parsing \"many\": invalid syntax",
    "details": null,
    "hint": "run 'otman --help' for usage"
  }
}

$ otman list OTM-1 --json
exit: 2
-- stdout --
-- stderr --
{
  "schema_version": 1,
  "error": {
    "code": "invalid_arguments",
    "message": "unknown command \"OTM-1\" for \"otman list\"",
    "details": null,
    "hint": "run 'otman --help' for usage"
  }
}

