$ otman config show --json --format axi
exit: 2
-- stdout --
-- stderr --
error:
  code: conflicting_flags
  message: "--json conflicts with --format axi"
  details:
    flags[2]: "--json","--format"
  hint: "pass either --json or --format, not both"

$ otman config show --format xml
exit: 2
-- stdout --
-- stderr --
error:
  code: invalid_format
  message: "unknown output format \"xml\""
  details:
    allowed[3]: human,axi,json
    format: xml
  hint: "use --format human, axi or json"

$ otman bogus --json
exit: 2
