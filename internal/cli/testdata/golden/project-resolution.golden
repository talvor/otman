$ otman config show --json
exit: 0
-- stdout --
{
  "schema_version": 1,
  "data": {
    "config_path": "$WORK/config/otman/config.toml",
    "pointer_path": "$WORK/repo/.otman.toml",
    "vault": {
      "value": "$WORK/vault",
      "source": "config"
    },
    "actor": {
      "value": null,
      "source": null
    },
    "project": {
      "value": "WEB",
      "source": "pointer"
    }
  },
  "warnings": []
}
-- stderr --

$ otman project view --json
exit: 0
-- stdout --
{
  "schema_version": 1,
  "data": {
    "project": {
      "key": "WEB",
      "name": "otman website",
      "path": "Projects/WEB",
      "note": "Projects/WEB/WEB.md"
    }
  },
  "warnings": []
}
-- stderr --

