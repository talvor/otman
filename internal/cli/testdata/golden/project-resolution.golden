$ otman project view --json --project NOPE
exit: 3
-- stdout --
-- stderr --
{
  "schema_version": 1,
  "error": {
    "code": "project_not_found",
    "message": "no Project NOPE in the Vault",
    "details": {
      "key": "NOPE",
      "source": "flag"
    },
    "hint": "run 'otman project list' to see the Projects, or 'otman project create NOPE --name NAME'"
  }
}

$ otman project view
env: OTM_PROJECT=lower
exit: 2
-- stdout --
-- stderr --
error:
  code: invalid_project_key
  message: "invalid Project key \"lower\""
  details:
    key: lower
    source: env
  hint: "use an uppercase letter followed by up to 15 uppercase letters or digits, such as OTM"

== tree ==
config/
config/otman/
-- config/otman/config.toml --
vault = "$WORK/vault"
project = "OTM"
home/
outer/
-- outer/.otman.toml --
project = "WEB"
outer/inner/
outer/inner/.git/
-- outer/inner/.git/HEAD --
ref: refs/heads/main
repo/
repo/.git/
-- repo/.git/HEAD --
ref: refs/heads/main
-- repo/.otman.toml --
project = "WEB"
repo/sub/
-- repo/sub/.keep --
vault/
vault/.otman/
-- vault/.otman/.gitignore --
*
-- vault/.otman/lock --
-- vault/.otman/otman.db --
[sqlite database]
vault/Projects/
vault/Projects/OTM/
-- vault/Projects/OTM/OTM.md --
---
name: otman
kind: project
---
vault/Projects/WEB/
-- vault/Projects/WEB/WEB.md --
---
name: otman website
kind: project
---
