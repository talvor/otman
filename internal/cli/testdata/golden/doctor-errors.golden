$ otman doctor DOC-1 --all-projects
exit: 2
-- stdout --
-- stderr --
error:
  code: conflicting_flags
  message: "--all-projects conflicts with a REF"
  details:
    flags[2]: "--all-projects",a REF
  hint: "pass either a REF or --all-projects, not both"

$ otman doctor --all-projects --project DOC
exit: 2
-- stdout --
-- stderr --
error:
  code: conflicting_flags
  message: "--all-projects conflicts with --project"
  details:
    flags[2]: "--all-projects","--project"
  hint: "pass either --all-projects or --project, not both"

$ otman doctor NOPE-1
exit: 3
-- stdout --
-- stderr --
error:
  code: project_not_found
  message: no Project NOPE in the Vault
  details:
    key: NOPE
  hint: "run 'otman project list' to see the Projects, or 'otman project create NOPE --name NAME'"

