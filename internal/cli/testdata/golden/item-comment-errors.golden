$ otman comment OTM-1 --body a
<!-- otman:comments -->
b --json
env: OTM_ACTOR=talvor
exit: 2
-- stdout --
-- stderr --
{
  "schema_version": 1,
  "error": {
    "code": "reserved_marker",
    "message": "the body from --body contains the reserved line <!-- otman:comments -->",
    "details": {
      "marker": "<!-- otman:comments -->",
      "source": "--body"
    },
    "hint": "remove that line; otman uses it to mark where comments begin"
  }
}

