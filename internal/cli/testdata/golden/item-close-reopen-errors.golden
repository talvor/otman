$ otman reopen Handle sync collisions
exit: 3
-- stdout --
-- stderr --
error:
  code: item_not_found
  message: "no Item matches \"Handle sync collisions\""
  details:
    ref: Handle sync collisions
  hint: "name an Item by its ID (OTM-12), its number, its full filename or its Vault-relative path; titles do not match"

$ otman close WEB-1 --project OTM --json
exit: 2
-- stdout --
-- stderr --
{
  "schema_version": 1,
  "error": {
    "code": "project_mismatch",
    "message": "WEB-1 is in Project WEB, but --project is OTM",
    "details": {
      "flag": "OTM",
      "project": "WEB",
      "ref": "WEB-1"
    },
    "hint": "drop --project, or pass --project WEB"
  }
}

